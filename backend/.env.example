# ===== LLM provider =====
# Options: openrouter (recommended, free models) | gemini | ollama | heuristic
LLM_PROVIDER=openrouter

# --- OpenRouter (one OpenAI-compatible API, many free models) ---
# Get a free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# A capable free model. Browse free models at https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Comma-separated fallbacks tried when the primary is rate-limited/unavailable.
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME="Global ATS Optimizer"

# --- Google Gemini (free tier) ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Ollama (local open-source models) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ===== Database (Neon Postgres) =====
# Optional. When set, ATS score history & copilot chats are persisted.
# Get one free: https://neon.tech  (use the pooled connection string)
DATABASE_URL=

# ===== RAG embeddings =====
# Options: tfidf (default, lightweight) | sentence-transformers
EMBEDDINGS_BACKEND=tfidf
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ===== CORS (comma separated frontend origins) =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== Limits =====
MAX_UPLOAD_MB=10
